{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/suppliers-admin",
      "destination": "/suppliers-admin.html"
    },
    {
      "source": "/supplier",
      "destination": "/supplier-portal.html"
    },
    {
      "source": "/supplier-finance",
      "destination": "/supplier-finance.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-BLNK-Deploy",
          "value": "2026-09-27-1524"
        }
      ]
    }
  ]
}
