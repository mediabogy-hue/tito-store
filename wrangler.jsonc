{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blnk-store",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "assets": {"directory": "./dist-cloudflare", "binding": "ASSETS", "run_worker_first": true},
  "build": {"command": "node scripts/build-cloudflare.mjs"}
}
